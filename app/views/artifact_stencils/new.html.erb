<%= render "layouts/navbar" %>
<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6">
    <h1 class="text-3xl font-bold mb-2">New Artifact Stencil</h1>
    <p class="text-lg text-base-content/70">Create a reusable template for generating artifacts</p>
  </div>

  <%= render partial: "errors", locals: { artifact_stencil: @artifact_stencil } %>

  <div class="grid gap-6 md:grid-cols-3">
    <!-- Main Form -->
    <div class="md:col-span-2">
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <%= form_with model: @artifact_stencil || ArtifactStencil.new, local: true do |form| %>
            <div class="form-control mb-6">
              <%= form.label :name, "Name", class: "label" %>
              <%= form.text_field :name, 
                  class: "input input-bordered w-full", 
                  required: true,
                  aria: { describedby: "name-help" } %>
              <div class="label">
                <span class="label-text-alt" id="name-help">A descriptive name for your stencil</span>
              </div>
            </div>

            <div class="form-control mb-6">
              <%= form.label :description, "Description", class: "label" %>
              <%= form.text_area :description, 
                  class: "textarea textarea-bordered", 
                  rows: 3,
                  required: true,
                  aria: { describedby: "description-help" } %>
              <div class="label">
                <span class="label-text-alt" id="description-help">Explain what this stencil creates</span>
              </div>
            </div>

            <div class="form-control mb-6">
              <%= form.label :prompt, "Prompt Template", class: "label" %>
              <%= form.text_area :prompt, 
                  class: "textarea textarea-bordered font-mono", 
                  rows: 8,
                  required: true,
                  aria: { describedby: "prompt-help" } %>
              <div class="label">
                <span class="label-text-alt" id="prompt-help">The prompt template for generating artifacts</span>
              </div>
            </div>

            <!-- Settings -->
            <div class="form-control mb-6">
              <h3 class="card-title text-lg mb-4">Settings</h3>

              <!-- Published Checkbox -->
              <%= form.label :published, class: "label cursor-pointer flex items-center gap-3 mb-4" do %>
                <%= form.check_box :published, class: "checkbox checkbox-primary" %>
                <span class="label-text text-base-content/80">Make this stencil public</span>
              <% end %>

              <!-- Type Radio Buttons -->
              <fieldset class="space-y-3" required aria-describedby="category-help">
                <legend class="label label-text font-medium text-base-content/90 mb-2">Output Type</legend>
                <div class="flex flex-col gap-3">
                  <%= form.label :category_regular_text, class: "cursor-pointer flex items-center gap-3" do %>
                    <%= form.radio_button :category, "regular_text", class: "radio radio-primary", required: true %>
                    <span class="label-text text-base-content/80">Generate Text</span>
                  <% end %>
                  <%= form.label :category_mermaid, class: "cursor-pointer flex items-center gap-3" do %>
                    <%= form.radio_button :category, "mermaid", class: "radio radio-primary" %>
                    <span class="label-text text-base-content/80">Generate Mermaid Diagram</span>
                  <% end %>
                </div>
                <div class="label">
                  <span class="label-text-alt text-base-content/60" id="category-help">Select the type of artifact this stencil will generate</span>
                </div>
              </fieldset>
            </div>

            <div class="flex gap-4 pt-4 border-t border-base-300">
              <%= form.submit "Create Stencil", class: "btn btn-primary" %>
              <%= link_to "Cancel", favorite_artifact_stencils_path, class: "btn" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Tips -->
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h3 class="card-title text-lg">Tips</h3>
          <div class="space-y-2 text-sm">
            <div>• Use clear, specific instructions</div>
            <div>• Include placeholders like {topic}</div>
            <div>• Provide examples when helpful</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>