<%= render "layouts/navbar" %>
<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6">
    <h1 class="text-3xl font-bold mb-2"><%= @artifact_stencil.name %></h1>
    <p class="text-lg text-base-content/70"><%= @artifact_stencil.description %></p>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <!-- Main Content -->
    <div class="md:col-span-2">
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Prompt Template</h2>
          <div class="bg-base-200 p-4 rounded-lg">
            <pre class="text-sm whitespace-pre-wrap font-mono"><%= @artifact_stencil.prompt %></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Status -->
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h3 class="card-title text-lg">Status</h3>
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium">Visibility:</span>
              <div class="badge <%= @artifact_stencil.published? ? 'badge-success' : 'badge-neutral' %>">
                <%= @artifact_stencil.published? ? 'Public' : 'Private' %>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium">Usage Count:</span>
              <span class="text-sm"><%= @artifact_stencil.usage_count %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h3 class="card-title text-lg">Actions</h3>
          <div class="space-y-2">
            <% if @artifact_stencil.published || Current.user == @artifact_stencil.user %>
              <%= link_to "Use This Stencil", "#", class: "btn btn-primary btn-sm w-full" %>
            <% end %>

            <% if Current.user == @artifact_stencil.user %>
              <%= button_to "Delete", @artifact_stencil, 
                  method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this stencil?" },
                  class: "btn btn-error btn-outline btn-sm w-full" %>
              <% end %>
          </div>
        </div>
      </div>

      <!-- Meta Information -->
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h3 class="card-title text-lg">Information</h3>
          <div class="space-y-2 text-sm">
            <div>
              <span class="font-medium">Created:</span>
              <time datetime="<%= @artifact_stencil.created_at.iso8601 %>">
                <%= @artifact_stencil.created_at.strftime("%B %d, %Y") %>
              </time>
            </div>
            <div>
              <span class="font-medium">Last Updated:</span>
              <time datetime="<%= @artifact_stencil.updated_at.iso8601 %>">
                <%= @artifact_stencil.updated_at.strftime("%B %d, %Y") %>
              </time>
            </div>
            <% if @artifact_stencil.user %>
              <div>
                <span class="font-medium">Created by:</span>
                <%= @artifact_stencil.user.name %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>