<!-- app/views/layouts/_navbar.html.erb -->
<style>
  .logo-container {
    position: relative;
    width: 2rem;
    height: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .logo-outline {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    color: var(--not-quite-black);
    filter: 
      drop-shadow(0 0 1px var(--bright-off-white))
      contrast(2);
    opacity: 0.7;
    transform: scale(1.03);
  }
  
  /* Navbar styling with our color palette */
  .navbar {
    background-color: var(--bright-off-white);
    border-bottom: 1px solid var(--bright-off-white);
  }
  
  .navbar-link {
    color: var(--not-quite-black);
    font-family: var(--font-jakarta);
  }
  
  .navbar-link:hover {
    color: var(--electric-blue);
  }
  
  .navbar-brand {
    font-family: var(--font-space);
    color: var(--not-quite-black);
  }
  
  .btn-outline {
    color: var(--not-quite-black);
    border-color: var(--not-quite-black);
    font-family: var(--font-jakarta);
  }
  
  .btn-outline:hover {
    background-color: var(--not-quite-black);
    color: var(--bright-off-white);
  }
  
  .btn-primary {
    background-color: var(--electric-blue);
    border-color: var(--electric-blue);
    color: var(--bright-off-white);
    font-family: var(--font-jakarta);
  }
  
  .btn-primary:hover {
    background-color: #2563eb; /* A slightly darker blue */
    border-color: #2563eb;
  }
</style>

<nav class="navbar shadow-md">
  <!-- Left Side: Logo, SaaS Name, and Feature Links -->
  <div class="navbar-start">
    <!-- Logo and SaaS Name -->
    <div class="flex items-center space-x-2">
      <!-- Artistic Logo - Simplified -->
      <div class="logo-container">
        <%= image_tag "petals.svg", 
             class:"logo-base w-8 h-8", 
             alt: "Logo" %>
      </div>
      <span class="font-bold text-xl navbar-brand">stencil-ai</span>
    </div>
    
    <!-- Feature Links (hidden on mobile) -->
    <div class="hidden md:flex ml-8 space-x-6">
      <%= link_to "Features", "#", class: "navbar-link font-medium" %>
      <%= link_to "Solutions", "#", class: "navbar-link font-medium" %>
      <%= link_to "Pricing", "#", class: "navbar-link font-medium" %>
      <%= link_to "Resources", "#", class: "navbar-link font-medium" %>
    </div>
  </div>
  
  <!-- Mobile Menu Toggle -->
  <div class="navbar-center md:hidden">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--not-quite-black)">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
      </div>
      <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow rounded-box w-52" style="background-color: var(--bright-off-white)">
        <li><%= link_to "Features", "#", class: "navbar-link" %></li>
        <li><%= link_to "Solutions", "#", class: "navbar-link" %></li>
        <li><%= link_to "Pricing", "#", class: "navbar-link" %></li>
        <li><%= link_to "Resources", "#", class: "navbar-link" %></li>
        <li><%= link_to "Sign Up", "#", class: "navbar-link" %></li>
        <li><%= link_to "Login", "#", class: "navbar-link" %></li>
      </ul>
    </div>
  </div>
  
  <!-- Right Side: Sign Up and Login Buttons -->
  <div class="navbar-end hidden md:flex space-x-3">
    <%= link_to "Login", "#", class: "btn btn-outline" %>
    <%= link_to "Sign Up", "#", class: "btn btn-primary" %>
  </div>
</nav>