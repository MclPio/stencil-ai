<section class="min-h-screen bg-bright-off-white flex flex-col items-center justify-start relative overflow-hidden">
  <div class="container mx-auto px-4 py-16 lg:py-24 text-center z-10">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-space text-not-quite-black leading-tight mb-6">
      Never repeat your <span class="text-electric-blue">prompts</span> again
    </h1>
    
    <p class="text-lg md:text-xl font-jakarta text-not-quite-black opacity-80 mb-10 max-w-2xl mx-auto">
      No more copy pasting, no more writing the same old prompts, no more wasting time on different chat pages. 
      Stencil AI is your concurrent prompt workflow designed to save time on solving repetitive problems.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Create Your First Workflow", "#", class: "btn bg-electric-blue text-white border-0 hover:bg-blue-600 text-lg px-8 py-3 rounded-lg font-jakarta font-medium shadow-lg hover:shadow-xl transition-all" %>
      <button class="btn bg-transparent border-2 border-not-quite-black text-not-quite-black hover:bg-not-quite-black hover:text-bright-off-white text-lg px-8 py-3 rounded-lg font-jakarta font-medium transition-all">Watch Demo</button>
    </div>
  </div>
</section>