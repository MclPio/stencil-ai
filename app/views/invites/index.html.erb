<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Invite Codes</h1>
    <%= link_to "Create New Invite", new_invite_path, class: "btn btn-primary" %>
  </div>

  <% if @invites.any? %>
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th>Invite Code</th>
            <th>Status</th>
            <th>Expires At</th>
            <th>Used By</th>
            <th>Created At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @invites.each do |invite| %>
            <tr>
              <td>
                <code class="bg-base-200 px-2 py-1 rounded text-sm font-mono">
                  <%= invite.invite_code %>
                </code>
              </td>
              <td>
                <% if invite.used_by_id %>
                  <div class="badge badge-success">Activated</div>
                <% else %>
                  <% if invite.active? %>
                    <div class="badge badge-warning">Pending</div>
                  <% else %>
                    <div class="badge badge-error">Expired</div>
                  <% end %>
                <% end %>
              </td>
              <td>
                <% if invite.expires_at %>
                  <time class="text-sm" datetime="<%= invite.expires_at.iso8601 %>">
                    <%= invite.expires_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </time>
                <% else %>
                  <span class="text-base-content/60">Never expires</span>
                <% end %>
              </td>
              <td>
                <% if !invite.activated? && invite.user %>
                  <div class="flex items-center gap-2">
                    <div class="avatar placeholder">
                      <div class="bg-neutral text-neutral-content rounded-full w-6 h-6">
                        <span class="text-xs"><%= invite.user.name.first.upcase %></span>
                      </div>
                    </div>
                    <%= invite.user.name %>
                  </div>
                <% else %>
                  <span class="text-base-content/60 italic">Not used</span>
                <% end %>
              </td>
              <td>
                <time class="text-sm" datetime="<%= invite.created_at.iso8601 %>">
                  <%= invite.created_at.strftime("%B %d, %Y") %>
                </time>
              </td>
              <td>
                <%= button_to invite_path(invite), 
                    method: :delete, 
                    class: "btn btn-ghost btn-xs text-error hover:bg-error hover:text-error-content",
                    data: { turbo_confirm: "Are you sure you want to delete this invite code? This action cannot be undone." },
                    title: "Delete invite" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  Delete
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="hero min-h-64">
      <div class="hero-content text-center">
        <div class="max-w-md">
          <div class="text-6xl mb-4">📧</div>
          <h2 class="text-xl font-semibold mb-2">No invite codes yet</h2>
          <p class="text-base-content/70 mb-6">
            Create your first invite code to start inviting users to your application.
          </p>
          <%= link_to "Create First Invite", new_invite_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>