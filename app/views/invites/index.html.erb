<%# 
  Helper to determine the status and color for an invite badge.
  The logic is ordered by priority:
  1. Activated: A single-use code that has been redeemed. This is a final state.
  2. Reusable: A code that is active and can be used multiple times.
  3. Pending: A single-use code that is active and waiting to be used.
  4. Expired: Any code that has passed its expiration date.
%>
<%
def invite_status_badge(invite)
  # 1. If it's been used, its final state is "Activated". This is terminal for single-use codes.
  if invite.used_by_id.present?
    return content_tag(:div, "Activated", class: "badge badge-success")
  end

  # 2. If it's reusable and not expired, it's "Reusable".
  if invite.reusable? && invite.active?
    return content_tag(:div, "Reusable", class: "badge badge-primary")
  end

  # 3. If it's a single-use code and still active, it's "Pending".
  if invite.active?
    return content_tag(:div, "Pending", class: "badge badge-warning")
  end

  # 4. If it's not used and not active, it must be expired.
  if invite.expires_at&.past?
    return content_tag(:div, "Expired", class: "badge badge-error")
  end
  
  # 5. Fallback for any other inactive state
  content_tag(:div, "Inactive", class: "badge badge-ghost")
end
%>

<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Invite Codes</h1>
    <%= link_to "Create New Invite", new_invite_path, class: "btn btn-primary" %>
  </div>

  <% if @invites.any? %>
    <div class="overflow-x-auto bg-base-100 rounded-lg shadow">
      <table class="table w-full">
        <thead>
          <tr>
            <th>Invite Code</th>
            <th>Status</th>
            <th>Used By</th>
            <th>Expires At</th>
            <th>Created At</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @invites.each do |invite| %>
            <tr>
              <td>
                <code class="bg-base-200 px-2 py-1 rounded text-sm font-mono">
                  <%= invite.invite_code %>
                </code>
              </td>
              <td>
                <%= invite_status_badge(invite) %>
              </td>
              <td>
                <% if invite.user %>
                  <div class="flex items-center gap-2">
                    <div class="avatar placeholder">
                      <div class="bg-neutral text-neutral-content rounded-full w-6 h-6">
                        <span class="text-xs"><%= invite.user.name.first.upcase %></span>
                      </div>
                    </div>
                    <span title="<%= invite.user.email_address %>"><%= invite.user.name %></span>
                  </div>
                <% else %>
                  <span class="text-base-content/60 italic">
                    <%= invite.reusable? ? "Multiple Users" : "Not used" %>
                  </span>
                <% end %>
              </td>
              <td>
                <% if invite.expires_at %>
                  <time class="text-sm" datetime="<%= invite.expires_at.iso8601 %>">
                    <%= invite.expires_at.strftime("%b %d, %Y") %>
                  </time>
                <% else %>
                  <span class="text-base-content/60">Never</span>
                <% end %>
              </td>
              <td>
                <time class="text-sm" datetime="<%= invite.created_at.iso8601 %>">
                  <%= invite.created_at.strftime("%b %d, %Y") %>
                </time>
              </td>
              <td>
                <%= button_to invite_path(invite), 
                    method: :delete, 
                    class: "btn btn-ghost btn-sm float-right",
                    data: { turbo_confirm: "Are you sure you want to delete this invite code? This action cannot be undone." },
                    title: "Delete invite" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16">
        <div class="text-6xl mb-4">📧</div>
        <h2 class="text-xl font-semibold mb-2">No invite codes yet</h2>
        <p class="text-base-content/70 mb-6 max-w-md mx-auto">
          Create your first invite code to start allowing users to register for your application.
        </p>
        <%= link_to "Create First Invite", new_invite_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
