<!-- _spec.html.erb -->
<div class="mermaid-container" data-scale="1" data-translate-x="0" data-translate-y="0">
  <% if @project.specs.last.id %>
    <div class="mermaid">
      <%= raw @project.specs.last.content %>
    </div>
  <% else %>
    <div class="flex items-center justify-center h-full text-base-content/50">
      <p>No diagram generated yet. Start a chat to create one.</p>
    </div>
  <% end %>
</div>