<h2>Projects</h2>
<%# class %>
<ul class="list bg-base-100 rounded-box shadow-md mb-4">
  <% @projects.each do |project| %>
    <li class="list-row">
      <div class="list-col-grow">
        <span><%= project.title %></span>
      </div>
      <%= link_to "Chat", project_conversation_path(project), class: "btn btn-primary" %>
      <%= link_to "Specs", project_spec_path(project), class: "btn btn-secondary" %>
      <%= button_to "Delete", project, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-warning" %>
      <%# link to chat %>
      <%# link to specs if generated %>
      <%# Delete edit for project here %>
    </li>
  <% end %>
</ul>

<%= link_to new_project_path do %>
  New Project
<% end %>
