<h2 class="text-3xl font-bold text-primary mb-6">Projects</h2><%# class %>
<ul class="list bg-base-100 rounded-box shadow-md mb-4">
  <% @projects.each do |project| %>
    <li class="list-row">
      <div class="list-col-grow">
        <span class="text-lg font-medium"><%= project.title %></span>
      </div>
      <%= link_to "Chat", project_conversation_path(project), class: "btn btn-primary btn-soft" %>
      <%= link_to "Specs", project_spec_path(project), class: "btn btn-secondary btn-soft" %>
      <%= button_to "Delete", project, method: :delete, data: { turbo_confirm: "Are you sure? Your associated specs and chat will be destroyed." }, class: "btn btn-error btn-md btn-outline hover:bg-error hover:text-white" %>
    </li>
  <% end %>
</ul>

<%= link_to "New Project", new_project_path, class: "btn btn-primary mt-6 w-full md:w-auto hover:btn-accent-focus" %>
