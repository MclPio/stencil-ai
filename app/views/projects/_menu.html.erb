<ul class="menu bg-base-200 rounded-box" data-controller="project-menu">
  <li>
    <a data-action="click->project-menu#expand" data-project-menu-target="arrow">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>

      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
  </li>
  <li>
    <%= link_to new_project_path do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span class="hidden" data-project-menu-target="newProjectSpan">New Project</span>
    <% end %>
  </li>
  <li>
    <%= link_to projects_path do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
      </svg>
      <span class="hidden" data-project-menu-target="projectsSpan">Projects</span>
    <% end %>
  </li>
  <p class="hidden" data-project-menu-target="link">Projects</p>
  <% projects.each do |p| %>
    <li class="hidden" data-project-menu-target="link">
      <div class="flex items-center justify-between w-full pr-1">
        <%= link_to project_conversation_path(p), class: "flex-grow #{p == project ? 'menu-focus' : ''}" do %>
          <span id="project_menu_title_<%= p.id %>"><%= p.title.truncate(16) %></span>
        <% end %>
        <div class="dropdown dropdown-end">
          <label tabindex="0" class="btn btn-ghost btn-xs p-1">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
          </label>
          <ul tabindex="0" class="dropdown-content z-10 menu p-2 shadow bg-base-100 rounded-box w-40">
            <li><button onclick="rename_modal_<%= p.id %>.showModal(); event.preventDefault();" class="text-sm">Rename</button></li>
            <li><button onclick="delete_modal_<%= p.id %>.showModal(); event.preventDefault();" class="text-sm text-error">Delete</button></li>
          </ul>
        </div>
      </div>
    </li>
  <% end %>
</ul>

<% projects.each do |p| %>
  <dialog id="rename_modal_<%= p.id %>" class="modal">
    <div class="modal-box">
      <h3 class="text-lg font-bold mb-4">Rename Project</h3>
      <%= form_with model: p, data: { controller: "modal" } do |form| %>
        <div class="flex flex-col gap-4">
          <div class="w-full">
            <%= form.text_field :title, class: "input input-bordered w-full" %>
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" class="btn" onclick="rename_modal_<%= p.id %>.close()">Cancel</button>
            <%= form.submit 'Save', class: "btn btn-primary", data: { action: "submit->modal#closeOnSuccess" } %>
          </div>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
  
  <!-- Delete Modal -->
  <dialog id="delete_modal_<%= p.id %>" class="modal">
    <div class="modal-box">
      <h3 class="text-lg font-bold mb-4">Delete Project</h3>
      <p class="py-2">Are you sure you want to delete "<%= p.title %>"? This action cannot be undone.</p>
      <div class="flex justify-end gap-2 mt-4">
        <button type="button" class="btn" onclick="delete_modal_<%= p.id %>.close()">Cancel</button>
        <%= button_to "Delete", p, method: :delete, class: "btn btn-error" %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
<% end %>

<script>
  document.addEventListener('turbo:submit-end', (event) => {
    if (event.detail.success) {
      // Close any open modals when form submission is successful
      const modals = document.querySelectorAll('.modal[open]');
      modals.forEach(modal => {
        modal.close();
      });
    }
  });
</script>