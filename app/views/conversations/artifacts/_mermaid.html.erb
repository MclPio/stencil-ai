<!-- Raw Mermaid Code -->
<div class="mb-6">
  <h2 class="text-xl font-bold mb -2">Mermaid JS Code</h2>
  <pre class="bg-gray-100 p-4 rounded-lg overflow-x-auto"><code><%= @project.artifacts.find(artifact_id).content %></code></pre>
</div>

<!-- Rendered Diagram -->
<div class="mb-6">
  <h2 class="text-xl font-bold mb-2">Mermaid Diagram</h2>
  <div id="mermaid-diagram-model" class="mermaid bg-white p-4 border rounded-lg" data-svg-zoom-target="diagram">
    <%= @project.artifacts.find(artifact_id).content %>
  </div>
</div>