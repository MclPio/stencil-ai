<div class="max-w-3xl mx-auto">
  <% conversation.user_assistant_messages.each do |message| %>
    <% if message.role == "user" %>
      <%= render partial: "user_role", locals: { message: message }%>
    <% elsif message.role == "assistant" %>
      <%= render partial: "assistant_role", locals: { message: message }%>
    <% end %>
  <% end %>
</div>
