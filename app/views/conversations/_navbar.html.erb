<div class="navbar bg-base-100 shadow-sm sticky top-0 z-50">
  <!-- Left side with project selector -->
  <div class="flex-1">
    <ul class="menu menu-horizontal px-1">
      <li>
        <details>
          <summary id="project_title_<%= @conversation.project.id %>"><%= @conversation.project.title %></summary>
          <ul class="bg-base-100 rounded-t-none p-2">
            <li><button onclick="my_modal_2.showModal()">Rename</button></li>
            <dialog id="my_modal_2" class="modal">
              <div class="modal-box">
                <h3 class="text-lg font-bold mb-4">Rename Project</h3>
                <%= form_with model: @conversation.project do |form| %>
                  <div class="flex flex-col gap-4">
                    <div class="w-full">
                      <%= form.text_field :title, class: "input input-bordered w-full" %>
                    </div>
                    <div class="flex justify-end gap-2">
                      <button type="button" class="btn" onclick="my_modal_2.close()">Cancel</button>
                      <%= form.submit 'Save', class: "btn btn-primary", data: { action: "submit->modal#closeOnSuccess" }%>
                    </div>
                  </div>
                <% end %>
              </div>
              <form method="dialog" class="modal-backdrop">
                <button>close</button>
              </form>
            </dialog>
            <li>
              <%= button_to "Delete", @conversation.project, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-error" %>
            </li>
          </ul>
        </details>
      </li>
    </ul>
  </div>
  
  <!-- Right side with Open Artifacts button -->
  <div class="flex-none">
    <ul class="menu menu-horizontal px-1">
      <li>
        <button data-action="click->artifact#open" data-artifact-target="openButton">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
        </button>
      </li>
    </ul>
  </div>
</div>

<script>
  document.addEventListener('turbo:submit-end', (event) => {
    if (event.detail.success) {
      const modal = document.getElementById('my_modal_2');
      modal.close();
    }
  });
</script>