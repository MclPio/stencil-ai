<%= form_with model: Message.new, url: messages_url, html: { class: "", data: { controller: "message-form", turbo_frame: "_top", action: "turbo:submit-end->message-form#resetForm input->message-form#updateSubmitButton" } } do |form| %>
  <%= form.hidden_field :conversation_id, value: conversation.id %>
  <div class="chat-form">
    <div class="chat-form__border">
      <%= form.text_area :content, data: { controller: 'auto-expand', action: "input->auto-expand#resize keydown->message-form#handleKeydown", 'message-form-target': 'textarea' }, class:"min-h-[6rem] max-h-[12rem] resize-none chat-form__textarea", placeholder:"Lets Build, provide me a detailed writeup about your project" %>
      <div class="chat-form__input-groups">
        <div class="chat-form__input-checkbox">
          <%= form.label :general_chat, "General Chat" %>
          <%= form.checkbox :general_chat, checked: true%>
        </div>
        <%= form.button class: "btn btn-primary p-2 rounded-full chat-form__input-submit", data: {'message-form-target': 'submit' } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256">
            <path d="M208.49,120.49a12,12,0,0,1-17,0L140,69V216a12,12,0,0,1-24,0V69L64.49,120.49a12,12,0,0,1-17-17l72-72a12,12,0,0,1,17,0l72,72A12,12,0,0,1,208.49,120.49Z"></path>
          </svg>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
