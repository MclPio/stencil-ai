<!-- app/views/specs/show.html.erb -->
<div class="max-w-4xl mx-auto py-8">
 <!-- Raw Mermaid Code -->
 <div class="mb-6">
 <h2 class="text-xl font-bold mb -2">Mermaid JS Code</h2>
 <pre class="bg-gray-100 p-4 rounded-lg overflow-x-auto"><code><%= @spec.model_erd %></code></pre>
 </div>

 <!-- Rendered Diagram -->
 <div class="mb-6">
 <h2 class="text-xl font-bold mb-2">ERD Diagram</h2>
 <div id="mermaid-diagram" class="mermaid bg-white p-4 border rounded-lg">
 <%= @spec.model_erd %>
 </div>
 </div>
</div>

<script type="module">
 import mermaid from 'mermaid';
 mermaid.initialize({ startOnLoad: true, theme: 'default' });
</script>